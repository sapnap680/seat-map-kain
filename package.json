{
  "name": "seat-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "convert-pdfs": "python scripts/extract_seats_from_pdf.py && python scripts/convert_pdfs.py",
    "convert-pdfs-legacy": "python scripts/extract_seats_from_pdf.py && set SEAT_MAP_LEGACY_CONVERT=1&& python scripts/convert_pdfs.py",
    "extract-seats": "python scripts/extract_seats_from_pdf.py",
    "copy-pdfs": "python scripts/copy_pdfs.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
