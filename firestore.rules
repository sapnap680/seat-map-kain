rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /seatStatus/{slug} {
      allow read: if slug in ['2025-12-11', '2025-12-12', '2025-12-13'];
      allow create, update: if request.auth != null
        && slug in ['2025-12-11', '2025-12-12', '2025-12-13']
        && request.resource.data.keys().hasOnly(['sold']);
      allow delete: if false;
    }
  }
}
