# VITE_STAFF_EMAIL=staff@example.com
# VITE_STAFF_PASSWORD=your-shared-password

# 任意: 「公開URLをコピー」に使う固定URL（未設定時は現在のページURL）
# VITE_PUBLIC_URL=https://map-two-brown.vercel.app/
