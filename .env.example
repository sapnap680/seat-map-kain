VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# 本番: ログインUIなしで席を保存するため共有スタッフアカウント（Vercel の Environment Variables に設定）
# VITE_STAFF_EMAIL=staff@example.com
# VITE_STAFF_PASSWORD=your-shared-password

# 任意: 「公開URLをコピー」に使う固定URL（未設定時は現在のページURL）
# VITE_PUBLIC_URL=https://map-two-brown.vercel.app/
